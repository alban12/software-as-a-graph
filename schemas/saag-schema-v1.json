{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SaagGraphSchema",
  "description": "Software as a Graph (SaaG) Intermediate Representation schema v1.0.0",
  "type": "object",
  "required": ["schemaVersion", "metadata", "nodes", "edges"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "metadata": {
      "type": "object",
      "required": ["projectName", "targetPlatform", "rootPath", "lastSynchronizedAt"],
      "properties": {
        "projectName": { "type": "string" },
        "targetPlatform": {
          "type": "string",
          "enum": ["swift", "typescript", "python", "generic"]
        },
        "rootPath": { "type": "string" },
        "lastSynchronizedAt": { "type": "string" },
        "sourceChecksum": { "type": "string" }
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/SaagNode"
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/SaagEdge"
      }
    },
    "activeWorkspace": {
      "$ref": "#/definitions/AgentWorkspace"
    }
  },
  "definitions": {
    "SaagNode": {
      "type": "object",
      "required": ["id", "name", "level", "kind", "inputs", "outputs"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "level": {
          "type": "string",
          "enum": ["L1_SYSTEM", "L2_COMPONENT", "L3_EXECUTION"]
        },
        "kind": {
          "type": "string",
          "enum": [
            "view",
            "viewModel",
            "service",
            "repository",
            "externalSystem",
            "function",
            "handler",
            "stateHolder",
            "decisionBranch"
          ]
        },
        "parentId": { "type": "string" },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/Port" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/definitions/Port" }
        },
        "stateProps": {
          "type": "array",
          "items": { "$ref": "#/definitions/StateProperty" }
        },
        "viewElements": {
          "type": "array",
          "items": { "$ref": "#/definitions/ViewElement" }
        },
        "isTransient": { "type": "boolean" },
        "isSqueezed": { "type": "boolean" },
        "serviceMeta": { "$ref": "#/definitions/ServiceMeta" },
        "previewMeta": { "$ref": "#/definitions/PreviewMeta" },
        "perfMeta": { "$ref": "#/definitions/NodePerfMeta" },
        "sourceAnchor": { "$ref": "#/definitions/SourceAnchor" },
        "canvasMeta": { "$ref": "#/definitions/CanvasMeta" }
      }
    },
    "Port": {
      "type": "object",
      "required": ["id", "name", "typeAnnotation", "direction"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "typeAnnotation": { "type": "string" },
        "schemaSnippet": { "type": "string" },
        "direction": {
          "type": "string",
          "enum": ["input", "output"]
        },
        "isAsync": { "type": "boolean" },
        "canThrow": { "type": "boolean" }
      }
    },
    "StateProperty": {
      "type": "object",
      "required": ["name", "typeAnnotation"],
      "properties": {
        "name": { "type": "string" },
        "typeAnnotation": { "type": "string" },
        "wrapperKind": { "type": "string" },
        "defaultValue": { "type": "string" },
        "isReadOnly": { "type": "boolean" }
      }
    },
    "PreviewMeta": {
      "type": "object",
      "required": ["hasPreview"],
      "properties": {
        "hasPreview": { "type": "boolean" },
        "previewKind": {
          "type": "string",
          "enum": ["device_frame", "component_mockup", "live_render"]
        },
        "deviceFrame": {
          "type": "string",
          "enum": ["iphone-16-pro", "ipad", "mac"]
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "previewUrl": { "type": "string" },
              "stateDescription": { "type": "string" }
            }
          }
        }
      }
    },
    "SourceAnchor": {
      "type": "object",
      "required": ["filePath", "symbolPath", "startLine", "startColumn", "endLine", "endColumn"],
      "properties": {
        "filePath": { "type": "string" },
        "symbolPath": { "type": "string" },
        "startLine": { "type": "integer" },
        "startColumn": { "type": "integer" },
        "endLine": { "type": "integer" },
        "endColumn": { "type": "integer" },
        "symbolChecksum": { "type": "string" }
      }
    },
    "CanvasMeta": {
      "type": "object",
      "required": ["position"],
      "properties": {
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "isCollapsed": { "type": "boolean" },
        "colorTag": { "type": "string" }
      }
    },
    "SaagEdge": {
      "type": "object",
      "required": ["id", "sourceNodeId", "sourcePortId", "targetNodeId", "targetPortId", "edgeKind", "executionMode"],
      "properties": {
        "id": { "type": "string" },
        "sourceNodeId": { "type": "string" },
        "sourcePortId": { "type": "string" },
        "targetNodeId": { "type": "string" },
        "targetPortId": { "type": "string" },
        "edgeKind": {
          "type": "string",
          "enum": ["call", "dataTransfer", "stateBinding", "eventEmit", "dependencyInject"]
        },
        "executionMode": {
          "type": "string",
          "enum": ["sync", "async", "reactive_stream"]
        },
        "contract": {
          "type": "object",
          "required": ["payloadType"],
          "properties": {
            "payloadType": { "type": "string" },
            "guarantees": {
              "type": "array",
              "items": { "type": "string" }
            },
            "errorType": { "type": "string" }
          }
        },
        "perfMeta": { "$ref": "#/definitions/EdgePerfMeta" }
      }
    },
    "ViewElement": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["textField", "secureField", "button", "text", "progressView", "toggle"]
        },
        "label": { "type": "string" },
        "binding": { "type": "string" },
        "action": { "type": "string" },
        "startLine": { "type": "integer" },
        "endLine": { "type": "integer" }
      }
    },
    "ServiceMeta": {
      "type": "object",
      "required": ["serviceType"],
      "properties": {
        "serviceType": { "type": "string" },
        "provider": { "type": "string" },
        "projectRef": { "type": "string" },
        "status": { "type": "string" },
        "consoleUrl": { "type": "string" },
        "collections": {
          "type": "array",
          "items": { "type": "string" }
        },
        "endpoints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "BoundaryPort": {
      "type": "object",
      "required": ["nodeId", "portId", "portName", "direction", "typeAnnotation"],
      "properties": {
        "nodeId": { "type": "string" },
        "nodeName": { "type": "string" },
        "portId": { "type": "string" },
        "portName": { "type": "string" },
        "direction": { "type": "string", "enum": ["input", "output"] },
        "typeAnnotation": { "type": "string" },
        "connectedToNodeId": { "type": "string" },
        "connectedToNodeName": { "type": "string" }
      }
    },
    "AgentWorkspace": {
      "type": "object",
      "required": ["id", "name", "lockedNodeIds", "allowedFilePaths", "frozenBoundaryPorts"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "lockedNodeIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowedFilePaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frozenBoundaryPorts": {
          "type": "array",
          "items": { "$ref": "#/definitions/BoundaryPort" }
        },
        "forbiddenFilePaths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "agentPrompt": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "RetainCycleRisk": {
      "type": "object",
      "required": ["symbol", "line", "description", "severity", "suggestion"],
      "properties": {
        "symbol": { "type": "string" },
        "line": { "type": "integer" },
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["warning", "critical"] },
        "suggestion": { "type": "string" }
      }
    },
    "NodePerfMeta": {
      "type": "object",
      "properties": {
        "retainCycleRisks": {
          "type": "array",
          "items": { "$ref": "#/definitions/RetainCycleRisk" }
        },
        "estimatedMemoryMb": { "type": "number" },
        "cpuTimeMs": { "type": "number" }
      }
    },
    "EdgePerfMeta": {
      "type": "object",
      "properties": {
        "averageLatencyMs": { "type": "number" },
        "isCriticalPath": { "type": "boolean" }
      }
    }
  }
}
